
TARGETS =	$(TARGET1)

#==============================================================================

FILENAME1 =	d0
TARGET1 =	$(FILENAME1)

HEADERS1 = 	\
		ascii_codes.h \
		done.h \
		file_xfr.h \
		install_dir.h \
		nio.h \
		rand.h \
		rpc.h \
		text_box.h \
		url.h \
		$(NULL)

CCFILES1 =	\
		call_http.c \
		call_nio.c \
		check_home.c \
		do_data_in.c \
		done.c \
		file_xfr.c \
		get_login.c \
		get_url.c \
		install_dir.c \
		play_intro.c \
		print_func.c \
		rand.c \
		rpc.c \
		text_box.c \
		url.c \
		main.c \
		$(NULL)

OBJS1 =		${CCFILES1:.c=.o}

LIBS1 = 	\
		-lutil \
		-lSDL_ttf \
		-lSDL_image \
		-lSDL_mixer \
		-lsmpeg \
		$(AUDIO_LIB_BIN) \
		$(COLOR_LIB_BIN) \
		$(EVENT_LIB_BIN) \
		$(FILE_IO_LIB_BIN) \
		$(FONT_LIB_BIN) \
		$(IMAGE_LIB_BIN) \
		$(MSG_LIB_BIN) \
		$(SCP_LIB_BIN) \
		$(SCREEN_LIB_BIN) \
		$(SDL_LIB_BIN) \
		$(SOCK_LIB_BIN) \
		$(STR_LIB_BIN) \
		$(TERM_LIB_BIN) \
		$(MOVIE_LIB_BIN) \
		$(NULL)

#==============================================================================

AUDIO_LIB =		audio_lib
AUDIO_LIB_PATH =	$(AUDIO_LIB)
AUDIO_LIB_BIN =		$(AUDIO_LIB_PATH)/audio_lib.a

COLOR_LIB =		color_lib
COLOR_LIB_PATH =	$(COLOR_LIB)
COLOR_LIB_BIN =		$(COLOR_LIB_PATH)/color_lib.a

EVENT_LIB =		event_lib
EVENT_LIB_PATH =	$(EVENT_LIB)
EVENT_LIB_BIN =		$(EVENT_LIB_PATH)/event_lib.a

FILE_IO_LIB =		file_io_lib
FILE_IO_LIB_PATH =	$(FILE_IO_LIB)
FILE_IO_LIB_BIN =	$(FILE_IO_LIB)/file_io_lib.a

FONT_LIB =		font_lib
FONT_LIB_PATH =		$(FONT_LIB)
FONT_LIB_BIN =		$(FONT_LIB_PATH)/font_lib.a

IMAGE_LIB =		image_lib
IMAGE_LIB_PATH =	$(IMAGE_LIB)
IMAGE_LIB_BIN =		$(IMAGE_LIB_PATH)/image_lib.a

MSG_LIB =		msg_lib
MSG_LIB_PATH =		$(MSG_LIB)
MSG_LIB_BIN =		$(MSG_LIB_PATH)/msg_lib.a

SCP_LIB =		scp_lib
SCP_LIB_PATH =		$(SCP_LIB)
SCP_LIB_BIN =		$(SCP_LIB_PATH)/scp_lib.a

SCREEN_LIB =		screen_lib
SCREEN_LIB_PATH =	$(SCREEN_LIB)
SCREEN_LIB_BIN =	$(SCREEN_LIB_PATH)/screen_lib.a

SDL_LIB =		sdl_lib
SDL_LIB_PATH =		$(SDL_LIB)
SDL_LIB_BIN =		$(SDL_LIB_PATH)/sdl_lib.a

MOVIE_LIB =		movie_lib
MOVIE_LIB_PATH =	$(MOVIE_LIB)
MOVIE_LIB_BIN =		$(MOVIE_LIB_PATH)/movie_lib.a

SOCK_LIB =		sock_lib
SOCK_LIB_PATH =		$(SOCK_LIB)
SOCK_LIB_BIN =		$(SOCK_LIB_PATH)/sock_lib.a

STR_LIB =		str_lib
STR_LIB_PATH =		$(STR_LIB)
STR_LIB_BIN =		$(STR_LIB_PATH)/str_lib.a

TERM_LIB =		term_lib
TERM_LIB_PATH =		$(TERM_LIB)
TERM_LIB_BIN =		$(TERM_LIB_PATH)/term_lib.a

#==============================================================================

CC =		gcc

COPTS =		-O3 -g -Wall $(shell sdl-config --cflags)

INCLUDES = 	\
		$(NULL)

LIBDIRS = 	\
		$(NULL)
 
#CFLAGS =	$(COPTS) $(INCLUDES) -DUNIX
CFLAGS =	$(COPTS) $(INCLUDES) -DDEBUG -DUNIX

LFLAGS =	$(LIBDIRS)

#default compilation rules
%.o:		%.c
		$(CC) -c $< $(CFLAGS) -o $@

all: 		$(TARGETS)

default:	$(TARGETS)

new:		clean default

#==============================================================================

$(TARGET1):	$(OBJS1) $(HEADERS1) $(LIBS1)
		$(CC) $(LFLAGS) $(OBJS1) $(LIBS1) -o $@
		cp $(TARGET1) ..

$(AUDIO_LIB_BIN):
		cd $(AUDIO_LIB_PATH); make

$(COLOR_LIB_BIN):
		cd $(COLOR_LIB_PATH); make

$(EVENT_LIB_BIN):
		cd $(EVENT_LIB_PATH); make

$(FILE_IO_LIB_BIN):
		cd $(FILE_IO_LIB_PATH); make

$(FONT_LIB_BIN):
		cd $(FONT_LIB_PATH); make

$(IMAGE_LIB_BIN):
		cd $(IMAGE_LIB_PATH); make

$(MSG_LIB_BIN):
		cd $(MSG_LIB_PATH); make

$(SCP_LIB_BIN):
		cd $(SCP_LIB_PATH); make

$(SCREEN_LIB_BIN):
		cd $(SCREEN_LIB_PATH); make

$(SDL_LIB_BIN):
		cd $(SDL_LIB_PATH); make

$(MOVIE_LIB_BIN):
		cd $(MOVIE_LIB_PATH); make

$(SOCK_LIB_BIN):
		cd $(SOCK_LIB_PATH); make

$(STR_LIB_BIN):
		cd $(STR_LIB_PATH); make

$(TERM_LIB_BIN):
		cd $(TERM_LIB_PATH); make

indent:
		cd $(AUDIO_LIB_PATH); make indent
		cd $(COLOR_LIB_PATH); make indent
		cd $(EVENT_LIB_PATH); make indent
		cd $(FILE_IO_LIB_PATH); make indent
		cd $(FONT_LIB_PATH); make indent
		cd $(IMAGE_LIB_PATH); make indent
		cd $(MSG_LIB_PATH); make indent
		cd $(SCP_LIB_PATH); make indent
		cd $(SCREEN_LIB_PATH); make indent
		cd $(SDL_LIB_PATH); make indent
		cd $(MOVIE_LIB_PATH); make indent
		cd $(SOCK_LIB_PATH); make indent
		cd $(STR_LIB_PATH); make indent
		cd $(TERM_LIB_PATH); make indent
		cd $(SOCK_LIB_PATH); make indent
		indent -kr -i8 *.h *.c 

clean:
		cd $(AUDIO_LIB_PATH); make clean
		cd $(COLOR_LIB_PATH); make clean
		cd $(EVENT_LIB_PATH); make clean
		cd $(FILE_IO_LIB_PATH); make clean
		cd $(FONT_LIB_PATH); make clean
		cd $(IMAGE_LIB_PATH); make clean
		cd $(MSG_LIB_PATH); make clean
		cd $(SCP_LIB_PATH); make clean
		cd $(SCREEN_LIB_PATH); make clean
		cd $(SDL_LIB_PATH); make clean
		cd $(MOVIE_LIB_PATH); make clean
		cd $(SOCK_LIB_PATH); make clean
		cd $(STR_LIB_PATH); make clean
		cd $(TERM_LIB_PATH); make clean
		rm -f $(TARGETS) *.o *.a core a.out *~ .*.swp
 
